# =============================================================
# DocHub BD - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# APPLICATION
NODE_ENV=development
PORT=4000
APP_NAME="DocHub BD"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================
# DATABASE (PostgreSQL)
# =============================================================
DATABASE_URL="postgresql://dochub:dochub_password@localhost:5432/dochub_bd?schema=public&connection_limit=20&pool_timeout=10"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dochub_bd
DATABASE_USER=dochub
DATABASE_PASSWORD=dochub_password

# =============================================================
# REDIS
# =============================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# =============================================================
# JWT AUTHENTICATION
# =============================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-change-this
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================
# CLERK (Alternative Auth - optional)
# =============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# =============================================================
# ELASTICSEARCH
# =============================================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_DOCTORS_INDEX=dochub_doctors
ELASTICSEARCH_HOSPITALS_INDEX=dochub_hospitals

# =============================================================
# CLOUDINARY (Image Storage)
# =============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=dochub_uploads

# =============================================================
# EMAIL (SMTP)
# =============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="DocHub BD <noreply@dochubbd.com>"

# =============================================================
# SMS - Bangladesh (SSL Wireless / Infobip / Twilio)
# =============================================================
SMS_PROVIDER=ssl_wireless
SSL_WIRELESS_USER=your-ssl-user
SSL_WIRELESS_PASS=your-ssl-pass
SSL_WIRELESS_SID=your-sender-id
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================
# GOOGLE MAPS
# =============================================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
GOOGLE_MAPS_SERVER_KEY=your-server-side-key

# =============================================================
# PAYMENT GATEWAYS (Bangladesh)
# =============================================================
# bKash
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_PUBLIC_KEY=your-nagad-public-key
NAGAD_PRIVATE_KEY=your-nagad-private-key
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# SSL Commerz
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_LIVE=false

# =============================================================
# RATE LIMITING
# =============================================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# =============================================================
# NEXT.JS FRONTEND
# =============================================================
NEXT_PUBLIC_APP_NAME="DocHub BD"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_DESCRIPTION="Bangladesh's #1 Doctor Discovery Platform. Find & Book the Best Doctors Near You."
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL=your-fb-pixel-id

# =============================================================
# MONITORING & LOGGING
# =============================================================
SENTRY_DSN=https://xxx@sentry.io/xxx
LOG_LEVEL=debug
LOG_FORMAT=combined

# =============================================================
# SECURITY
# =============================================================
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this
COOKIE_SECRET=your-cookie-secret-change-this

# =============================================================
# ADMIN
# =============================================================
ADMIN_EMAIL=admin@dochubbd.com
ADMIN_PASSWORD=Admin@DocHub2024!
SUPER_ADMIN_SECRET=your-super-admin-setup-secret
